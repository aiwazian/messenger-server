generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ChannelType {
  PUBLIC
  PRIVATE
}

enum GroupType {
  PUBLIC
  PRIVATE
}

enum PrivacyRule {
  EVERYBODY
  NOBODY
}

enum FileStatus {
  PENDING
  UPLOADED
  FAILED
}

enum MessageType {
  TEXT
  STICKER
  SYSTEM
}

enum SystemEventType {
  CHANNEL_CREATED
  GROUP_CREATED
  HISTORY_CLEARED
}

enum AttachmentType {
  IMAGE
  VIDEO
  VOICE
  FILE
}

/// Динамическая категория чатов внутри папки.
///
/// Категория хранится вместо перечисления конкретных чатов: новый чат
/// подходящего типа попадает в папку сам, без пересохранения папки.
enum ChatFolderCategory {
  PRIVATE_CHATS
  CHANNELS
  GROUPS
}

model User {
  id          BigInt  @id
  firstName   String
  lastName    String?
  bio         String?
  username    String? @unique
  login       String  @unique
  password    String
  dateOfBirth BigInt?
  email       String?

  profileChannelId BigInt?
  profileChannel   Channel? @relation("UserProfileChannel", fields: [profileChannelId], references: [id], onDelete: SetNull)

  chats        Chat[]
  sessions     Session[]
  sentMessages Message[]
  messageReads MessageRead[]
  chatReadStates ChatReadState[]
  chatFolders  ChatFolder[]

  photos UserPhoto[]

  ownedGroups      Group[]
  groupMemberships GroupMember[]
  groupBlackLists  GroupBlackList[]
  groupAdminPermissions GroupAdminPermission[]

  ownedChannels        Channel[]                @relation("OwnedChannels")
  channelSubscriptions ChannelSubscriber[]
  channelBlackLists    ChannelBlackList[]
  channelAdminPermissions ChannelAdminPermission[]

  privacySettings          PrivacySettings?
  scheduledAccountDeletion ScheduledAccountDeletion?

  messageReactions MessageReaction[]

  blockedUsers UserBlackList[] @relation("Blocker")
  blockedBy    UserBlackList[] @relation("Blocked")

  channelJoinRequests ChannelJoinRequest[]
  groupJoinRequests   GroupJoinRequest[]
}

model UserPhoto {
  id        Int     @id @default(autoincrement())
  userId    BigInt
  fileId    String  @unique
  isCurrent Boolean @default(false)
  sortOrder Int     @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([userId, isCurrent])
}

model Session {
  id     Int    @id @default(autoincrement())
  userId BigInt

  /// SHA-256 токена сессии в hex: сам токен на сервере не хранится.
  ///
  /// Токен бессрочный и лежит на устройстве, поэтому доступ к базе не должен
  /// давать возможность войти в аккаунт: восстановить токен из хэша нельзя.
  /// Совпадение хэша и есть проверка подлинности, отдельной подписи нет.
  tokenHash String @unique

  /// Firebase Installation ID устройства: адресат пуша в новом API FCM.
  ///
  /// null — штатное состояние: сессия создаётся в момент входа, когда FID
  /// ещё неизвестен — он приходит отдельным запросом после onRegistered.
  /// Сюда же возвращаемся, когда FCM ответил, что установки больше нет.
  installationId String?

  deviceModel String
  osVersion   String
  osName      String
  createdAt   BigInt
  lastSeen    BigInt?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([installationId])
}

model Chat {
  id     Int    @id @default(autoincrement())
  userId BigInt
  chatId BigInt

  chat_uniq_id String @unique

  isPinned   Boolean @default(false)
  isArchived Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  wallpaperId Int?
  wallpaper   Wallpaper? @relation(fields: [wallpaperId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([chatId])
}

/// Пользовательская папка чатов.
///
/// Папка «Все чаты» не хранится: клиент рисует её сам первой вкладкой,
/// поэтому в базе лежат только созданные пользователем папки.
model ChatFolder {
  id     Int    @id @default(autoincrement())
  userId BigInt
  name   String

  /// Позиция вкладки на главном экране. Задел под ручную сортировку папок:
  /// пока проставляется по порядку создания.
  sortOrder Int @default(0)

  createdAt BigInt

  user       User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  chats      ChatFolderChat[]
  categories ChatFolderCategoryFilter[]

  @@index([userId, sortOrder])
  @@index([userId])
}

/// Чат, добавленный в папку поимённо.
///
/// Закрепление живёт здесь, а не в Chat: один и тот же чат может быть
/// закреплён в одной папке и не закреплён в другой.
model ChatFolderChat {
  id       Int    @id @default(autoincrement())
  folderId Int
  chatId   BigInt

  /// Чат входит в состав папки поимённо. false означает, что строка заведена
  /// только ради закрепления чата, который попал в папку через категорию:
  /// при удалении категории такой чат из папки исчезает.
  isIncluded Boolean @default(true)

  isPinned  Boolean @default(false)
  sortOrder Int     @default(0)

  folder ChatFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@unique([folderId, chatId])
  @@index([folderId])
  @@index([chatId])
}

/// Категория, включённая в папку целиком.
///
/// Хранится отдельной строкой, а не массивом в ChatFolder: так категория
/// индексируется и не требует чтения всей папки при проверке.
model ChatFolderCategoryFilter {
  id       Int                @id @default(autoincrement())
  folderId Int
  category ChatFolderCategory

  folder ChatFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@unique([folderId, category])
  @@index([folderId])
}

model EncryptionKey {
  id        Int     @id @default(autoincrement())
  version   Int     @unique
  createdAt BigInt
  retiredAt BigInt?

  messages Message[]

  @@index([retiredAt])
}

model Message {
  id          BigInt      @id @default(autoincrement())
  sequenceId  BigInt
  chatId      BigInt
  text        String?
  sendTime    BigInt
  editedAt    BigInt?
  messageType MessageType

  encryptionKeyVersion Int
  encryptionKey        EncryptionKey? @relation(fields: [encryptionKeyVersion], references: [version])

  senderId BigInt
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  replyToId BigInt?
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplies")

  /// Чат цитируемого сообщения: ответить можно на сообщение из другого чата.
  replyToChatId BigInt?

  /// Источник пересылки: автор контента (userId) либо группа/канал.
  /// Дата пересылки и id исходного сообщения не хранятся осознанно.
  /// При пересылке уже пересланного источник наследуется: посредники не записываются.
  forwardedFromChatId BigInt?

  readReceipts     MessageRead[]
  attachments      MessageAttachment[]
  systemEvent      SystemMessageEvent?
  deletedFor       DeletedMessage[]
  messageReactions MessageReaction[]

  @@index([chatId, sendTime])
  // курсорная пагинация и окно вокруг сообщения идут по (chatId, id)
  @@index([chatId, id])
  @@index([replyToId])
  @@index([forwardedFromChatId])
  @@index([senderId])
  @@index([chatId])
  @@index([chatId, messageType])
  @@index([encryptionKeyVersion])
}

model SystemMessageEvent {
  id        Int             @id @default(autoincrement())
  messageId BigInt          @unique
  eventType SystemEventType

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([eventType])
}

/// Состояние прочтения чата для одного пользователя.
///
/// Считать непрочитанные каждый раз через COUNT по MessageRead дорого
/// (список чатов запрашивается на каждом открытии главного экрана),
/// поэтому счётчик и курсор денормализованы.
model ChatReadState {
  id     Int    @id @default(autoincrement())
  userId BigInt
  chatId BigInt

  /// Максимальный id прочитанного сообщения: всё до него считается прочитанным.
  lastReadMessageId BigInt?

  /// На этом сообщении клиент открывает чат, если есть непрочитанное.
  firstUnreadMessageId BigInt?

  unreadCount Int    @default(0)

  /// Пользователь сам пометил чат непрочитанным через меню списка чатов.
  /// Непрочитанных сообщений при этом может не быть вовсе: клиент рисует
  /// пустой бейдж. Сбрасывается при прочтении и при новом сообщении.
  isManuallyUnread Boolean @default(false)

  updatedAt   BigInt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chatId])
  @@index([userId])
  @@index([chatId])
}

model MessageRead {
  id        Int    @id @default(autoincrement())
  messageId BigInt
  userId    BigInt
  readAt    BigInt

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, readAt])
}

model MessageReaction {
  id        Int    @id @default(autoincrement())
  messageId BigInt
  userId    BigInt
  emoji     String
  reactedAt BigInt

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}

model DeletedMessage {
  id        Int    @id @default(autoincrement())
  messageId BigInt
  userId    BigInt
  deletedAt BigInt

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
  @@index([messageId])
}

model File {
  id        String     @id @default(uuid())
  name      String
  size      BigInt
  mimeType  String
  path      String
  status    FileStatus @default(PENDING)
  createdAt BigInt

  attachments   MessageAttachment[]
  userPhotos    UserPhoto[]
  channelPhotos ChannelPhoto[]
  groupPhotos   GroupPhoto[]
  wallpapers    Wallpaper[]

  @@index([status])
}

model MessageAttachment {
  id        Int            @id @default(autoincrement())
  messageId BigInt
  /// Без @unique: пересланная копия ссылается на тот же File, а не дублирует его.
  /// Физическое удаление файла — только когда исчезла последняя ссылка.
  fileId    String
  type      AttachmentType
  sortOrder Int            @default(0)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  file    File    @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([messageId, fileId])
  @@index([messageId])
  @@index([fileId])
}

model Channel {
  id          BigInt      @id
  name        String
  bio         String?
  ownerId     BigInt
  channelType ChannelType @default(PRIVATE)
  username    String?     @unique

  /// Запрет копирования: копирование текста, пересылка и сохранение медиа
  /// недоступны всем участникам, включая владельца.
  noCopy Boolean @default(false)

  owner User @relation("OwnedChannels", fields: [ownerId], references: [id], onDelete: Cascade)

  profileUsers User[] @relation("UserProfileChannel")

  photos       ChannelPhoto[]
  subscribers  ChannelSubscriber[]
  blockedUsers ChannelBlackList[]
  adminPermissions ChannelAdminPermission[]
  inviteLinks  ChannelInviteLink[]
  joinRequests ChannelJoinRequest[]
}

model ChannelPhoto {
  id        Int     @id @default(autoincrement())
  channelId BigInt
  fileId    String  @unique
  isCurrent Boolean @default(false)

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  file    File    @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([channelId, isCurrent])
}

model ChannelSubscriber {
  id        Int    @id @default(autoincrement())
  userId    BigInt
  channelId BigInt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@index([userId])
  @@index([channelId])
}

model ChannelBlackList {
  id        Int    @id @default(autoincrement())
  userId    BigInt
  channelId BigInt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
}

/// Права администратора канала.
///
/// Строка существует только для администраторов: владелец каналом управляет
/// без записи в этой таблице и всегда имеет все права.
model ChannelAdminPermission {
  id        Int    @id @default(autoincrement())
  channelId BigInt
  userId    BigInt

  /// Пригласительные ссылки: создание и удаление ссылок канала.
  canManageInviteLinks Boolean @default(false)

  /// Изменение профиля канала: название, описание и фотографии профиля.
  canEditProfile Boolean @default(false)

  /// Управление администраторами: назначение, снятие и изменение прав других
  /// администраторов канала. Права выше своих выдать нельзя.
  canManageAdmins Boolean @default(false)

  grantedBy BigInt?
  grantedAt BigInt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([channelId])
}

model Group {
  id        BigInt    @id
  ownerId   BigInt
  name      String
  username  String?   @unique
  bio       String?
  groupType GroupType @default(PRIVATE)

  /// Запрет копирования: копирование текста, пересылка и сохранение медиа
  /// недоступны всем участникам, включая владельца.
  noCopy Boolean @default(false)

  owner        User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  photos       GroupPhoto[]
  members      GroupMember[]
  blocked      GroupBlackList[]
  adminPermissions GroupAdminPermission[]
  inviteLinks  GroupInviteLink[]
  joinRequests GroupJoinRequest[]
}

model GroupPhoto {
  id        Int     @id @default(autoincrement())
  groupId   BigInt
  fileId    String  @unique
  isCurrent Boolean @default(false)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  file  File  @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([groupId, isCurrent])
}

model GroupMember {
  id      Int    @id @default(autoincrement())
  groupId BigInt
  userId  BigInt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId])
}

model GroupBlackList {
  id      Int    @id @default(autoincrement())
  userId  BigInt
  groupId BigInt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
}

/// Права администратора группы.
///
/// Строка существует только для администраторов: владелец группой управляет
/// без записи в этой таблице и всегда имеет все права.
model GroupAdminPermission {
  id      Int    @id @default(autoincrement())
  groupId BigInt
  userId  BigInt

  /// Пригласительные ссылки: создание и удаление ссылок группы.
  canManageInviteLinks Boolean @default(false)

  /// Изменение профиля группы: название, описание и фотографии профиля.
  canEditProfile Boolean @default(false)

  /// Управление администраторами: назначение, снятие и изменение прав других
  /// администраторов группы. Права выше своих выдать нельзя.
  canManageAdmins Boolean @default(false)

  /// Тег участника: подпись рядом с именем отправителя в сообщениях группы.
  /// Доступен только в группах, в каналах тега нет.
  tag String?

  grantedBy BigInt?
  grantedAt BigInt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
}

model GroupInviteLink {
  id              Int     @id @default(autoincrement())
  code            String  @unique
  groupId         BigInt
  creatorId       BigInt
  maxUses         Int?
  uses            Int     @default(0)
  expiresAt       BigInt?
  requireApproval Boolean @default(false)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

model GroupJoinRequest {
  id           Int    @id @default(autoincrement())
  groupId      BigInt
  userId       BigInt
  inviteLinkId Int?
  createdAt    BigInt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

model ChannelInviteLink {
  id              Int     @id @default(autoincrement())
  code            String  @unique
  channelId       BigInt
  creatorId       BigInt
  maxUses         Int?
  uses            Int     @default(0)
  expiresAt       BigInt?
  requireApproval Boolean @default(false)

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId])
}

model ChannelJoinRequest {
  id           Int    @id @default(autoincrement())
  channelId    BigInt
  userId       BigInt
  inviteLinkId Int?
  createdAt    BigInt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([channelId])
  @@index([userId])
}

model PrivacySettings {
  id     Int    @id @default(autoincrement())
  userId BigInt @unique

  lastSeen     PrivacyRule @default(EVERYBODY)
  messages     PrivacyRule @default(EVERYBODY)
  bio          PrivacyRule @default(EVERYBODY)
  dateOfBirth  PrivacyRule @default(EVERYBODY)
  invites      PrivacyRule @default(EVERYBODY)
  profilePhoto PrivacyRule @default(EVERYBODY)

  /// Кто может открыть профиль по заголовку «Переслано от».
  forwardedProfile PrivacyRule @default(EVERYBODY)

  deleteAfterDays Int @default(365)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ScheduledAccountDeletion {
  id          Int    @id @default(autoincrement())
  userId      BigInt @unique
  scheduledAt BigInt
  deleteAt    BigInt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([deleteAt])
}

model FileCleanupTask {
  id        Int    @id @default(autoincrement())
  fileId    String
  filePath  String
  attempts  Int    @default(0)
  createdAt BigInt
  nextRetry BigInt

  @@index([nextRetry])
}

model Wallpaper {
  id     Int    @id @default(autoincrement())
  fileId String @unique

  file  File   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  chats Chat[]
}

model UserBlackList {
  id        Int    @id @default(autoincrement())
  blockerId BigInt
  blockedId BigInt
  createdAt BigInt

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}
