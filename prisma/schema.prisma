generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ChannelType {
  PUBLIC
  PRIVATE
}

enum GroupType {
  PUBLIC
  PRIVATE
}

enum PrivacyRule {
  EVERYBODY
  NOBODY
}

enum FileStatus {
  PENDING
  UPLOADED
  FAILED
}

enum MessageType {
  TEXT
  STICKER
  SYSTEM
}

enum SystemEventType {
  CHANNEL_CREATED
  GROUP_CREATED
  HISTORY_CLEARED
}

enum AttachmentType {
  IMAGE
  VIDEO
  VOICE
  FILE
}

model User {
  id          BigInt  @id
  firstName   String
  lastName    String?
  bio         String?
  username    String? @unique
  login       String  @unique
  password    String
  dateOfBirth BigInt?
  email       String?

  profileChannelId BigInt?
  profileChannel   Channel? @relation("UserProfileChannel", fields: [profileChannelId], references: [id], onDelete: SetNull)

  chats        Chat[]
  sessions     Session[]
  sentMessages Message[]
  messageReads MessageRead[]
  chatReadStates ChatReadState[]

  photos UserPhoto[]

  ownedGroups      Group[]
  groupMemberships GroupMember[]
  groupBlackLists  GroupBlackList[]
  groupPermissions GroupMemberPermission[]

  ownedChannels        Channel[]                 @relation("OwnedChannels")
  channelSubscriptions ChannelSubscriber[]
  channelBlackLists    ChannelBlackList[]
  channelPermissions   ChannelMemberPermission[]

  privacySettings          PrivacySettings?
  scheduledAccountDeletion ScheduledAccountDeletion?

  messageReactions MessageReaction[]

  blockedUsers UserBlackList[] @relation("Blocker")
  blockedBy    UserBlackList[] @relation("Blocked")

  channelJoinRequests ChannelJoinRequest[]
  groupJoinRequests   GroupJoinRequest[]
}

model UserPhoto {
  id        Int     @id @default(autoincrement())
  userId    BigInt
  fileId    String  @unique
  isCurrent Boolean @default(false)
  sortOrder Int     @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([userId, isCurrent])
}

model Session {
  id          Int     @id @default(autoincrement())
  userId      BigInt
  token       String  @unique
  fcmToken    String?
  deviceModel String
  osVersion   String
  osName      String
  createdAt   BigInt
  lastSeen    BigInt?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
}

model Chat {
  id     Int    @id @default(autoincrement())
  userId BigInt
  chatId BigInt

  chat_uniq_id String @unique

  isPinned   Boolean @default(false)
  isArchived Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  wallpaperId Int?
  wallpaper   Wallpaper? @relation(fields: [wallpaperId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([chatId])
}

model EncryptionKey {
  id        Int     @id @default(autoincrement())
  version   Int     @unique
  createdAt BigInt
  retiredAt BigInt?

  messages Message[]

  @@index([retiredAt])
}

model Message {
  id          BigInt      @id @default(autoincrement())
  sequenceId  BigInt
  chatId      BigInt
  text        String?
  sendTime    BigInt
  editedAt    BigInt?
  messageType MessageType

  encryptionKeyVersion Int
  encryptionKey        EncryptionKey? @relation(fields: [encryptionKeyVersion], references: [version])

  senderId BigInt
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  replyToId BigInt?
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplies")

  /// Чат цитируемого сообщения: ответить можно на сообщение из другого чата.
  replyToChatId BigInt?

  /// Источник пересылки: автор контента (userId) либо группа/канал.
  /// Дата пересылки и id исходного сообщения не хранятся осознанно.
  /// При пересылке уже пересланного источник наследуется: посредники не записываются.
  forwardedFromChatId BigInt?

  readReceipts     MessageRead[]
  attachments      MessageAttachment[]
  systemEvent      SystemMessageEvent?
  deletedFor       DeletedMessage[]
  messageReactions MessageReaction[]

  @@index([chatId, sendTime])
  // курсорная пагинация и окно вокруг сообщения идут по (chatId, id)
  @@index([chatId, id])
  @@index([replyToId])
  @@index([forwardedFromChatId])
  @@index([senderId])
  @@index([chatId])
  @@index([chatId, messageType])
  @@index([encryptionKeyVersion])
}

model SystemMessageEvent {
  id        Int             @id @default(autoincrement())
  messageId BigInt          @unique
  eventType SystemEventType

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([eventType])
}

/// Состояние прочтения чата для одного пользователя.
///
/// Считать непрочитанные каждый раз через COUNT по MessageRead дорого
/// (список чатов запрашивается на каждом открытии главного экрана),
/// поэтому счётчик и курсор денормализованы.
model ChatReadState {
  id     Int    @id @default(autoincrement())
  userId BigInt
  chatId BigInt

  /// Максимальный id прочитанного сообщения: всё до него считается прочитанным.
  lastReadMessageId BigInt?

  /// На этом сообщении клиент открывает чат, если есть непрочитанное.
  firstUnreadMessageId BigInt?

  unreadCount Int    @default(0)
  updatedAt   BigInt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chatId])
  @@index([userId])
  @@index([chatId])
}

model MessageRead {
  id        Int    @id @default(autoincrement())
  messageId BigInt
  userId    BigInt
  readAt    BigInt

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, readAt])
}

model MessageReaction {
  id        Int    @id @default(autoincrement())
  messageId BigInt
  userId    BigInt
  emoji     String
  reactedAt BigInt

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}

model DeletedMessage {
  id        Int    @id @default(autoincrement())
  messageId BigInt
  userId    BigInt
  deletedAt BigInt

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
  @@index([messageId])
}

model File {
  id        String     @id @default(uuid())
  name      String
  size      BigInt
  mimeType  String
  path      String
  status    FileStatus @default(PENDING)
  createdAt BigInt

  attachments   MessageAttachment[]
  userPhotos    UserPhoto[]
  channelPhotos ChannelPhoto[]
  groupPhotos   GroupPhoto[]
  wallpapers    Wallpaper[]

  @@index([status])
}

model MessageAttachment {
  id        Int            @id @default(autoincrement())
  messageId BigInt
  /// Без @unique: пересланная копия ссылается на тот же File, а не дублирует его.
  /// Физическое удаление файла — только когда исчезла последняя ссылка.
  fileId    String
  type      AttachmentType
  sortOrder Int            @default(0)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  file    File    @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([messageId, fileId])
  @@index([messageId])
  @@index([fileId])
}

model Channel {
  id          BigInt      @id
  name        String
  bio         String?
  ownerId     BigInt
  channelType ChannelType @default(PRIVATE)
  username    String?     @unique

  /// Запрет копирования: копирование текста, пересылка и сохранение медиа
  /// недоступны всем участникам, включая владельца.
  noCopy Boolean @default(false)

  owner User @relation("OwnedChannels", fields: [ownerId], references: [id], onDelete: Cascade)

  profileUsers User[] @relation("UserProfileChannel")

  photos       ChannelPhoto[]
  subscribers  ChannelSubscriber[]
  blockedUsers ChannelBlackList[]
  permissions  ChannelMemberPermission[]
  inviteLinks  ChannelInviteLink[]
  joinRequests ChannelJoinRequest[]
}

model ChannelPhoto {
  id        Int     @id @default(autoincrement())
  channelId BigInt
  fileId    String  @unique
  isCurrent Boolean @default(false)

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  file    File    @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([channelId, isCurrent])
}

model ChannelSubscriber {
  id        Int    @id @default(autoincrement())
  userId    BigInt
  channelId BigInt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@index([userId])
  @@index([channelId])
}

model ChannelBlackList {
  id        Int    @id @default(autoincrement())
  userId    BigInt
  channelId BigInt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
}

model ChannelMemberPermission {
  id        Int    @id @default(autoincrement())
  channelId BigInt
  userId    BigInt

  canPostMessages Boolean @default(false)
  canSendMedia    Boolean @default(false)
  canPinMessages  Boolean @default(false)
  canInviteUsers  Boolean @default(false)
  canDeleteUsers  Boolean @default(false)
  canEditInfo     Boolean @default(false)
  canManageAdmins Boolean @default(false)

  grantedBy BigInt?
  grantedAt BigInt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([channelId])
}

model Group {
  id        BigInt    @id
  ownerId   BigInt
  name      String
  username  String?   @unique
  bio       String?
  groupType GroupType @default(PRIVATE)

  /// Запрет копирования: копирование текста, пересылка и сохранение медиа
  /// недоступны всем участникам, включая владельца.
  noCopy Boolean @default(false)

  owner        User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  photos       GroupPhoto[]
  members      GroupMember[]
  blocked      GroupBlackList[]
  permissions  GroupMemberPermission[]
  inviteLinks  GroupInviteLink[]
  joinRequests GroupJoinRequest[]
}

model GroupPhoto {
  id        Int     @id @default(autoincrement())
  groupId   BigInt
  fileId    String  @unique
  isCurrent Boolean @default(false)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  file  File  @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([groupId, isCurrent])
}

model GroupMember {
  id      Int    @id @default(autoincrement())
  groupId BigInt
  userId  BigInt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId])
}

model GroupBlackList {
  id      Int    @id @default(autoincrement())
  userId  BigInt
  groupId BigInt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
}

model GroupMemberPermission {
  id      Int    @id @default(autoincrement())
  groupId BigInt
  userId  BigInt

  canPostMessages Boolean @default(true)
  canSendMedia    Boolean @default(true)
  canPinMessages  Boolean @default(false)
  canInviteUsers  Boolean @default(true)
  canDeleteUsers  Boolean @default(false)
  canEditInfo     Boolean @default(false)
  canManageAdmins Boolean @default(false)

  grantedBy BigInt?
  grantedAt BigInt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
}

model GroupInviteLink {
  id              Int     @id @default(autoincrement())
  code            String  @unique
  groupId         BigInt
  creatorId       BigInt
  maxUses         Int?
  uses            Int     @default(0)
  expiresAt       BigInt?
  requireApproval Boolean @default(false)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

model GroupJoinRequest {
  id           Int    @id @default(autoincrement())
  groupId      BigInt
  userId       BigInt
  inviteLinkId Int?
  createdAt    BigInt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

model ChannelInviteLink {
  id              Int     @id @default(autoincrement())
  code            String  @unique
  channelId       BigInt
  creatorId       BigInt
  maxUses         Int?
  uses            Int     @default(0)
  expiresAt       BigInt?
  requireApproval Boolean @default(false)

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId])
}

model ChannelJoinRequest {
  id           Int    @id @default(autoincrement())
  channelId    BigInt
  userId       BigInt
  inviteLinkId Int?
  createdAt    BigInt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([channelId])
  @@index([userId])
}

model PrivacySettings {
  id     Int    @id @default(autoincrement())
  userId BigInt @unique

  lastSeen     PrivacyRule @default(EVERYBODY)
  messages     PrivacyRule @default(EVERYBODY)
  bio          PrivacyRule @default(EVERYBODY)
  dateOfBirth  PrivacyRule @default(EVERYBODY)
  invites      PrivacyRule @default(EVERYBODY)
  profilePhoto PrivacyRule @default(EVERYBODY)

  /// Кто может открыть профиль по заголовку «Переслано от».
  forwardedProfile PrivacyRule @default(EVERYBODY)

  deleteAfterDays Int @default(365)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ScheduledAccountDeletion {
  id          Int    @id @default(autoincrement())
  userId      BigInt @unique
  scheduledAt BigInt
  deleteAt    BigInt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([deleteAt])
}

model FileCleanupTask {
  id        Int    @id @default(autoincrement())
  fileId    String
  filePath  String
  attempts  Int    @default(0)
  createdAt BigInt
  nextRetry BigInt

  @@index([nextRetry])
}

model Wallpaper {
  id     Int    @id @default(autoincrement())
  fileId String @unique

  file  File   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  chats Chat[]
}

model UserBlackList {
  id        Int    @id @default(autoincrement())
  blockerId BigInt
  blockedId BigInt
  createdAt BigInt

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}
