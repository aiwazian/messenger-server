generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ChannelType {
  PUBLIC
  PRIVATE
}

enum GroupType {
  PUBLIC
  PRIVATE
}

enum PrivacyRule {
  EVERYBODY
  NOBODY
}

enum FileStatus {
  PENDING
  UPLOADED
  FAILED
}

enum MessageType {
  TEXT
  STICKER
  SYSTEM
}

enum SystemEventType {
  CHANNEL_CREATED
  GROUP_CREATED
  HISTORY_CLEARED
}

enum AttachmentType {
  IMAGE
  VIDEO
  VOICE
  FILE
}

enum ChatFolderCategory {
  PRIVATE_CHATS
  CHANNELS
  GROUPS
}

model User {
  id          BigInt  @id
  firstName   String
  lastName    String?
  bio         String?
  username    String? @unique
  login       String  @unique
  password    String
  dateOfBirth BigInt?

  email       String? @unique

  profileChannelId BigInt?
  profileChannel   Channel? @relation("UserProfileChannel", fields: [profileChannelId], references: [id], onDelete: SetNull)

  chats        Chat[]
  sessions     Session[]
  sentMessages Message[]
  chatReadStates ChatReadState[]
  chatFolders  ChatFolder[]

  photos UserPhoto[]

  ownedGroups      Group[]
  groupMemberships GroupMember[]
  groupBlackLists  GroupBlackList[]
  groupAdminPermissions GroupAdminPermission[]

  ownedChannels        Channel[]                @relation("OwnedChannels")
  channelSubscriptions ChannelSubscriber[]
  channelBlackLists    ChannelBlackList[]
  channelAdminPermissions ChannelAdminPermission[]

  privacySettings          PrivacySettings?
  notificationSettings     NotificationSettings?
  chatNotificationSettings ChatNotificationSetting[]
  scheduledAccountDeletion ScheduledAccountDeletion?

  messageReactions MessageReaction[]

  blockedUsers UserBlackList[] @relation("Blocker")
  blockedBy    UserBlackList[] @relation("Blocked")

  channelJoinRequests ChannelJoinRequest[]
  groupJoinRequests   GroupJoinRequest[]

  stickerPacks          StickerPack[]
  installedStickerPacks UserStickerPack[]
}

model UserPhoto {
  id        Int     @id @default(autoincrement())
  userId    BigInt
  fileId    String  @unique
  isCurrent Boolean @default(false)
  sortOrder Int     @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([userId, isCurrent])
}

model Session {
  id     Int    @id @default(autoincrement())
  userId BigInt

  tokenHash String @unique

  installationId String?

  deviceModel String
  osVersion   String
  osName      String
  createdAt   BigInt
  lastSeen    BigInt?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([installationId])
}

model Chat {
  id     Int    @id @default(autoincrement())
  userId BigInt
  chatId BigInt

  chat_uniq_id String @unique

  isPinned   Boolean @default(false)
  isArchived Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  wallpaperId Int?
  wallpaper   Wallpaper? @relation(fields: [wallpaperId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([chatId])
}

model ChatFolder {
  id     Int    @id @default(autoincrement())
  userId BigInt
  name   String

  sortOrder Int @default(0)

  createdAt BigInt

  user       User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  chats      ChatFolderChat[]
  categories ChatFolderCategoryFilter[]

  @@index([userId, sortOrder])
  @@index([userId])
}

model ChatFolderChat {
  id       Int    @id @default(autoincrement())
  folderId Int
  chatId   BigInt

  isIncluded Boolean @default(true)

  isPinned  Boolean @default(false)
  sortOrder Int     @default(0)

  folder ChatFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@unique([folderId, chatId])
  @@index([folderId])
  @@index([chatId])
}

model ChatFolderCategoryFilter {
  id       Int                @id @default(autoincrement())
  folderId Int
  category ChatFolderCategory

  folder ChatFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@unique([folderId, category])
  @@index([folderId])
}

model EncryptionKey {
  id        Int     @id @default(autoincrement())
  version   Int     @unique
  createdAt BigInt
  retiredAt BigInt?

  messages Message[]

  @@index([retiredAt])
}

model Message {
  id          BigInt      @id @default(autoincrement())
  sequenceId  BigInt
  chatId      BigInt
  text        String?
  sendTime    BigInt

  isEdited    Boolean     @default(false)
  messageType MessageType

  encryptionKeyVersion Int
  encryptionKey        EncryptionKey? @relation(fields: [encryptionKeyVersion], references: [version])

  senderId BigInt
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  stickerId BigInt?
  sticker   Sticker? @relation(fields: [stickerId], references: [id], onDelete: SetNull)

  replyToId BigInt?
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplies")

  replyToChatId BigInt?

  forwardedFromChatId BigInt?

  attachments      MessageAttachment[]
  systemEvent      SystemMessageEvent?
  deletedFor       DeletedMessage[]
  messageReactions MessageReaction[]

  @@index([chatId, sendTime])
  @@index([chatId, id])
  @@index([replyToId])
  @@index([forwardedFromChatId])
  @@index([senderId])
  @@index([chatId])
  @@index([chatId, messageType])
  @@index([encryptionKeyVersion])
  @@index([stickerId])
}

model SystemMessageEvent {
  id        Int             @id @default(autoincrement())
  messageId BigInt          @unique
  eventType SystemEventType

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([eventType])
}

model ChatReadState {
  id     Int    @id @default(autoincrement())
  userId BigInt
  chatId BigInt

  lastReadMessageId BigInt?

  firstUnreadMessageId BigInt?

  unreadCount Int    @default(0)

  isManuallyUnread Boolean @default(false)

  updatedAt   BigInt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chatId])
  @@index([userId])
  @@index([chatId])
}

model NotificationSettings {
  id     Int    @id @default(autoincrement())
  userId BigInt @unique

  privateChats Boolean @default(true)
  groups       Boolean @default(true)
  channels     Boolean @default(true)

  updatedAt BigInt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatNotificationSetting {
  id     Int    @id @default(autoincrement())
  userId BigInt
  chatId BigInt

  enabled Boolean

  updatedAt BigInt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chatId])
  @@index([userId])
  @@index([chatId])
}

model MessageReaction {
  id        Int    @id @default(autoincrement())
  messageId BigInt
  userId    BigInt
  emoji     String
  reactedAt BigInt

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}

model DeletedMessage {
  id        Int    @id @default(autoincrement())
  messageId BigInt
  userId    BigInt
  deletedAt BigInt

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
  @@index([messageId])
}

model File {
  id        String     @id @default(uuid())
  name      String
  size      BigInt
  mimeType  String
  path      String
  status    FileStatus @default(PENDING)
  createdAt BigInt

  width     Int?
  height    Int?

  attachments   MessageAttachment[]
  userPhotos    UserPhoto[]
  channelPhotos ChannelPhoto[]
  groupPhotos   GroupPhoto[]
  wallpapers    Wallpaper[]
  stickers      Sticker[]

  @@index([status])
}

model MessageAttachment {
  id        Int            @id @default(autoincrement())
  messageId BigInt
  fileId    String
  type      AttachmentType
  sortOrder Int            @default(0)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  file    File    @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([messageId, fileId])
  @@index([messageId])
  @@index([fileId])
}

model StickerPack {
  id   BigInt @id
  name String

  username String @unique

  ownerId   BigInt
  createdAt BigInt

  owner    User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  stickers Sticker[]
  installs UserStickerPack[]

  @@index([ownerId])
}

model Sticker {
  id     BigInt @id @default(autoincrement())
  packId BigInt

  fileId String

  emojis String[]

  sortOrder Int @default(0)

  createdAt BigInt

  pack StickerPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  file File        @relation(fields: [fileId], references: [id], onDelete: Cascade)

  messages Message[]

  @@index([packId, sortOrder])
  @@index([fileId])
}

model UserStickerPack {
  id     Int    @id @default(autoincrement())
  userId BigInt
  packId BigInt

  sortOrder Int @default(0)

  addedAt BigInt

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  pack StickerPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@unique([userId, packId])
  @@index([userId, sortOrder])
  @@index([packId])
}

model Channel {
  id          BigInt      @id
  name        String
  bio         String?
  ownerId     BigInt
  channelType ChannelType @default(PRIVATE)
  username    String?     @unique

  noCopy Boolean @default(false)

  owner User @relation("OwnedChannels", fields: [ownerId], references: [id], onDelete: Cascade)

  profileUsers User[] @relation("UserProfileChannel")

  photos       ChannelPhoto[]
  subscribers  ChannelSubscriber[]
  blockedUsers ChannelBlackList[]
  adminPermissions ChannelAdminPermission[]
  inviteLinks  ChannelInviteLink[]
  joinRequests ChannelJoinRequest[]
}

model ChannelPhoto {
  id        Int     @id @default(autoincrement())
  channelId BigInt
  fileId    String  @unique
  isCurrent Boolean @default(false)

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  file    File    @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([channelId, isCurrent])
}

model ChannelSubscriber {
  id        Int    @id @default(autoincrement())
  userId    BigInt
  channelId BigInt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@index([userId])
  @@index([channelId])
}

model ChannelBlackList {
  id        Int    @id @default(autoincrement())
  userId    BigInt
  channelId BigInt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
}

model ChannelAdminPermission {
  id        Int    @id @default(autoincrement())
  channelId BigInt
  userId    BigInt

  canManageInviteLinks Boolean @default(false)

  canEditProfile Boolean @default(false)

  canManageAdmins Boolean @default(false)

  grantedBy BigInt?
  grantedAt BigInt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([channelId])
}

model Group {
  id        BigInt    @id
  ownerId   BigInt
  name      String
  username  String?   @unique
  bio       String?
  groupType GroupType @default(PRIVATE)

  noCopy Boolean @default(false)

  owner        User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  photos       GroupPhoto[]
  members      GroupMember[]
  blocked      GroupBlackList[]
  adminPermissions GroupAdminPermission[]
  inviteLinks  GroupInviteLink[]
  joinRequests GroupJoinRequest[]
}

model GroupPhoto {
  id        Int     @id @default(autoincrement())
  groupId   BigInt
  fileId    String  @unique
  isCurrent Boolean @default(false)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  file  File  @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([groupId, isCurrent])
}

model GroupMember {
  id      Int    @id @default(autoincrement())
  groupId BigInt
  userId  BigInt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId])
}

model GroupBlackList {
  id      Int    @id @default(autoincrement())
  userId  BigInt
  groupId BigInt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
}

model GroupAdminPermission {
  id      Int    @id @default(autoincrement())
  groupId BigInt
  userId  BigInt

  canManageInviteLinks Boolean @default(false)

  canEditProfile Boolean @default(false)

  canManageAdmins Boolean @default(false)

  tag String?

  grantedBy BigInt?
  grantedAt BigInt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
}

model GroupInviteLink {
  id              Int     @id @default(autoincrement())
  code            String  @unique
  groupId         BigInt
  creatorId       BigInt
  maxUses         Int?
  uses            Int     @default(0)
  expiresAt       BigInt?
  requireApproval Boolean @default(false)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

model GroupJoinRequest {
  id           Int    @id @default(autoincrement())
  groupId      BigInt
  userId       BigInt
  inviteLinkId Int?
  createdAt    BigInt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

model ChannelInviteLink {
  id              Int     @id @default(autoincrement())
  code            String  @unique
  channelId       BigInt
  creatorId       BigInt
  maxUses         Int?
  uses            Int     @default(0)
  expiresAt       BigInt?
  requireApproval Boolean @default(false)

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId])
}

model ChannelJoinRequest {
  id           Int    @id @default(autoincrement())
  channelId    BigInt
  userId       BigInt
  inviteLinkId Int?
  createdAt    BigInt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([channelId])
  @@index([userId])
}

model PrivacySettings {
  id     Int    @id @default(autoincrement())
  userId BigInt @unique

  lastSeen     PrivacyRule @default(EVERYBODY)
  messages     PrivacyRule @default(EVERYBODY)
  bio          PrivacyRule @default(EVERYBODY)
  dateOfBirth  PrivacyRule @default(EVERYBODY)
  invites      PrivacyRule @default(EVERYBODY)
  profilePhoto PrivacyRule @default(EVERYBODY)

  forwardedProfile PrivacyRule @default(EVERYBODY)

  deleteAfterDays Int @default(365)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ScheduledAccountDeletion {
  id          Int    @id @default(autoincrement())
  userId      BigInt @unique
  scheduledAt BigInt
  deleteAt    BigInt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([deleteAt])
}

model FileCleanupTask {
  id        Int    @id @default(autoincrement())
  fileId    String
  filePath  String
  attempts  Int    @default(0)
  createdAt BigInt
  nextRetry BigInt

  @@index([nextRetry])
}

model Wallpaper {
  id     Int    @id @default(autoincrement())
  fileId String @unique

  file  File   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  chats Chat[]
}

model UserBlackList {
  id        Int    @id @default(autoincrement())
  blockerId BigInt
  blockedId BigInt
  createdAt BigInt

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}
